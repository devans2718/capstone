MERGE (n:Artifact {key: "art-sg-cells"}) SET n += {path: "results/span-grid/span-grid-cells-20261029.csv", kind: "csv", repo: "capstone", local_only: false, commit: "004ea19", name: "span-grid-cells-20261029.csv", layer: "design"};
MERGE (n:Artifact {key: "art-sg-comparisons"}) SET n += {path: "results/span-grid/span-grid-comparisons-20261029.csv", kind: "csv", repo: "capstone", local_only: false, commit: "004ea19", name: "span-grid-comparisons-20261029.csv", layer: "design"};
MERGE (n:Artifact {key: "art-sg-summary"}) SET n += {path: "results/span-grid/span-grid-summary-20261029.txt", kind: "report", repo: "capstone", local_only: false, commit: "004ea19", name: "span-grid-summary-20261029.txt", layer: "design"};
MERGE (n:Artifact {key: "art-sg-manifest"}) SET n += {path: "results/span-grid/run-manifest-span-grid.json", kind: "manifest", repo: "capstone", local_only: false, commit: "004ea19", name: "run-manifest-span-grid.json", layer: "design"};
MERGE (n:Artifact {key: "art-comm-summary"}) SET n += {path: "kg/communities/summary.json", kind: "summary", repo: "capstone", local_only: false, commit: "94e3eb8", name: "summary.json", layer: "design"};
MERGE (n:Artifact {key: "art-rc-summary"}) SET n += {path: "kg/communities/representation/summary.json", kind: "summary", repo: "capstone", local_only: false, commit: "e080786", name: "summary.json", layer: "design"};
MERGE (n:Paper {key: "paper-hewitt-liang"}) SET n += {short: "Hewitt & Liang 2019", title: "Designing and Interpreting Probes with Control Tasks", authors: "John Hewitt, Percy Liang", year: 2019, arxiv: "1909.03368", name: "Hewitt & Liang 2019", layer: "design"};
MERGE (n:Paper {key: "paper-zhang-bowman"}) SET n += {short: "Zhang & Bowman 2018", title: "Language Modeling Teaches You More Syntax than Translation Does: Lessons Learned Through Auxiliary Task Analysis", authors: "Kelly W. Zhang, Samuel R. Bowman", year: 2018, arxiv: "1809.10040", name: "Zhang & Bowman 2018", layer: "design"};
MERGE (n:Paper {key: "paper-pasad-2021"}) SET n += {short: "Pasad, Chou & Livescu 2021", title: "Layer-wise Analysis of a Self-supervised Speech Representation Model", authors: "Ankita Pasad, Ju-Chieh Chou, Karen Livescu", year: 2021, arxiv: "2107.04734", name: "Pasad, Chou & Livescu 2021", layer: "design"};
MERGE (n:Paper {key: "paper-pasad-2023"}) SET n += {short: "Pasad, Shi & Livescu 2023", title: "Comparative Layer-wise Analysis of Self-supervised Speech Models", authors: "Ankita Pasad, Bowen Shi, Karen Livescu", year: 2023, arxiv: "2211.03929", name: "Pasad, Shi & Livescu 2023", layer: "design"};
MERGE (n:Paper {key: "paper-wavjepa"}) SET n += {short: "Yuksel et al. 2025", title: "WavJEPA: Semantic Learning Unlocks Robust Audio Foundation Models for Raw Waveforms", authors: "Goksenin Yuksel, Pierre Guetschel, Michael Tangermann, Marcel van Gerven, Kiki van der Heijden", year: 2025, arxiv: "2509.23238", name: "Yuksel et al. 2025", layer: "design"};
MERGE (n:Concept {key: "con-phone"}) SET n += {term: "phone", definition: "A speech sound as actually produced, described by how it is articulated or how it sounds, whatever word it belongs to.", name: "phone", layer: "design"};
MERGE (n:Concept {key: "con-phoneme"}) SET n += {term: "phoneme", definition: "An abstract sound category a language uses to tell words apart. English /t/ and /d/ are different phonemes because 'tin' and 'din' are different words.", name: "phoneme", layer: "design"};
MERGE (n:Concept {key: "con-allophone"}) SET n += {term: "allophone", definition: "One of the predictable pronunciations of a phoneme in a particular context. The flap is an allophone of both /t/ and /d/ in American English.", name: "allophone", layer: "design"};
MERGE (n:Concept {key: "con-flap"}) SET n += {term: "flap", definition: "A very quick tap of the tongue tip against the ridge behind the upper teeth, written [ɾ]. In American English /t/ and /d/ are usually pronounced this way between vowels when the second is unstressed: 'water', 'ladder'.", name: "flap", layer: "design"};
MERGE (n:Concept {key: "con-neutralization"}) SET n += {term: "neutralization", definition: "A context where the difference between two phonemes is lost in pronunciation. Flapping neutralizes /t/ vs /d/ ('writer' and 'rider' can sound alike); Russian word-final devoicing neutralizes voicing (код 'code' and кот 'cat' both end in [t]). Small cues, such as the length of the preceding vowel, may survive.", name: "neutralization", layer: "design"};
MERGE (n:Concept {key: "con-underlying"}) SET n += {term: "underlying form", definition: "The phoneme a word has in its stored, dictionary form: /t/ in 'writer', /d/ in 'rider'. The pilot's labels are underlying forms.", name: "underlying form", layer: "design"};
MERGE (n:Concept {key: "con-surface"}) SET n += {term: "surface form", definition: "What is actually pronounced. At every pilot site it is a flap, by construction, so the label can't be read off the sound category.", name: "surface form", layer: "design"};
MERGE (n:Concept {key: "con-intervocalic"}) SET n += {term: "intervocalic", definition: "Between two vowels: the usual environment for flapping. Flapping also follows r, l and n ('hardy', 'party'), so the span grid's [Vɾ] and [VɾV] spans reach back through those to the vowel.", name: "intervocalic", layer: "design"};
MERGE (n:Concept {key: "con-probing"}) SET n += {term: "probing", definition: "Training a simple classifier (a probe) on a model's frozen internal representations, to test whether some property can be read out of them.", name: "probing", layer: "design"};
MERGE (n:Concept {key: "con-ssl-speech"}) SET n += {term: "self-supervised speech model", definition: "A model trained on unlabelled audio only, by predicting parts of its own input. No transcripts are used, so anything phonological it encodes was learned from sound alone.", name: "self-supervised speech model", layer: "design"};
MERGE (n:Finding {key: "find-sites"}) SET n += {candidate_cause: "Sites aren't what the inventory says", status: "ruled out for the sites, not the labels", statement: "A blind listening audit of 80 sites heard a flap in 72 of 74 decidable cases (6 /d/ can't-tells), and the right word and a well-placed clip in all 80. The labels come from the dictionary form and can't be heard under a flap, so the audit clears the sites, not the labels.", name: "Sites mislabelled?", layer: "design"};
MERGE (n:Finding {key: "find-width"}) SET n += {candidate_cause: "Site too narrow (2–4 frames)", status: "ruled out for MFCC; open for the encoders until the cropped design runs", statement: "Sites are 2–4 encoder frames wide (median 3, 27.4 ms). MFCC's 25 ms frames see only local audio (deltas reach ±40 ms), so for MFCC a cue outside the site's frames is invisible. WavJEPA and wav2vec2-base encode the flap ± 200 ms as one excerpt, so at depth their flap frames can carry that context; for WavJEPA the pilot shows only that the cue wasn't linearly recoverable from those frames. The span grid's pooled design (2026-10-29) widened the pooled frames to the preceding stretch, the following segment, or both, and no representation gained (largest +0.015, none called). For MFCC, whose frames are local, that rules width out, and the stretch's duration alone is near chance (about 0.53). For the encoders the pooled design cannot rule it out: every span's frames had heard the whole excerpt, so pooling more of them changes which frames are read, not what was heard. That test is the cropped design, deferred (span grid §8, 2026-10-29). Narrow frames don't explain WavJEPA's score on their own: from the same ɾ span, wav2vec2-base reaches 0.616 under joint, against WavJEPA's 0.543.", name: "Sites too narrow?", layer: "design"};
MERGE (n:Finding {key: "find-words"}) SET n += {candidate_cause: "The cue doesn't generalize to unseen words", status: "consistent with the result", statement: "The drop from random to joint is mostly the word axis: holding out speakers costs little, holding out word types costs most of the gap above chance.", name: "Doesn't generalize to unseen words", layer: "design"};
MERGE (n:Finding {key: "find-training"}) SET n += {candidate_cause: "Too little training data", status: "ruled out", statement: "Retraining the single-axis conditions at joint's training size (about 64% of sites) costs 0.006–0.013 at the best layer, against a 0.108 drop from random to joint.", name: "Too little training data?", layer: "design"};
MERGE (n:Finding {key: "find-power"}) SET n += {candidate_cause: "Too little statistical power", status: "limitation", statement: "The gap to MFCC's paired word-type bootstrap interval is [-0.015, +0.056]: no evidence of an advantage over MFCC, which is not evidence of none.", name: "Too little power", layer: "design"};
MERGE (n:Finding {key: "find-lemma"}) SET n += {candidate_cause: "Lemma overlap", status: "limitation, registered before the run", statement: "25.1% of joint test sites (2,612) have their lemma in training with the same label; the split is disjoint by word form, not lemma. On the 7,586 lemma-unseen sites the gap to MFCC is +0.030, CI [-0.004, +0.073], still short of criterion 1.", name: "Lemma overlap", layer: "design"};
MERGE (n:Finding {key: "find-sg-span"}) SET n += {question: "Does pooling over more of the neighbouring speech help, when the encoder heard the whole excerpt? (C1)", status: "no effect", statement: "Widening the pooled span helps no representation. Of the nine gaps (Vɾ, ɾV and VɾV minus ɾ, for WavJEPA, wav2vec2-base and MFCC), none reaches 0.05 and every paired 95% interval includes zero; the largest is +0.015 (MFCC, VɾV). The registered prediction, that Vɾ beats ɾ, is not supported.", name: "Wider spans don't help", layer: "design"};
MERGE (n:Finding {key: "find-sg-encoders"}) SET n += {question: "Does an encoder know more than the stretch's duration, and does it beat MFCC? (C4, C5)", status: "effect for wav2vec2-base; none for WavJEPA", statement: "wav2vec2-base scores 0.616–0.625 at its best layer on every span. It is called ahead of MFCC on all four spans (gaps +0.081 to +0.092), of MFCC with the clipped duration on Vɾ and VɾV (+0.070, +0.079), and of the clipped duration alone on Vɾ and VɾV (+0.089, +0.098). WavJEPA scores 0.543–0.555 and is called ahead of none of them; its largest gap to MFCC is +0.025 (Vɾ), half the threshold.", name: "wav2vec2 beats the baselines; WavJEPA doesn't", layer: "design"};
MERGE (n:Finding {key: "find-sg-duration"}) SET n += {question: "How far does the stretch's duration alone separate /t/ from /d/? (§5's baselines)", status: "reported, not compared", statement: "The preceding stretch's duration alone is near chance: 0.527 clipped to the excerpt, 0.529 unclipped, 0.524 for the vowel alone, each 95% interval including 0.50. Clipping costs 0.0015. Under a linear probe, lengthening before an underlying /d/, the cue the study set out to locate, barely separates /t/ from /d/ on these sites.", name: "Duration alone near chance", layer: "design"};
MERGE (n:Finding {key: "find-sg-depth"}) SET n += {question: "At what depth does the information peak? (C6)", status: "reported, no threshold", statement: "WavJEPA peaks early: layer 3 for ɾ, 4 for Vɾ and ɾV, 6 for VɾV, as the pilot's ɾ curve did (layer 3). wav2vec2-base peaks at layer 9 on every span, and each span's 95% range for the best layer lies within layers 6–10. The pilot's 2026-09-26 prediction, that WavJEPA's information sits higher than wav2vec2-base's, is reversed.", name: "Depth: WavJEPA early, wav2vec2 layer 9", layer: "design"};
MERGE (n:Finding {key: "find-sg-c7"}) SET n += {question: "Which encoder is better? (C7)", status: "no effect, as registered; the reverse reported, not called", statement: "C7 is computed as WavJEPA − wav2vec2-base, and §6's rule is one-sided, so it can call only a WavJEPA advantage: the registered call is no effect on all four spans. Reported, not called: wav2vec2-base is ahead by 0.062–0.075 on every span, every 95% interval below zero (§8, 2026-10-29). The encoders' order rests on C5, which calls wav2vec2-base ahead of MFCC on every span and WavJEPA on none.", name: "C7: no effect as registered", layer: "design"};
MERGE (n:Finding {key: "find-sg-checks"}) SET n += {question: "Can the grid's numbers be trusted? (§5's checks)", status: "passed", statement: "The WavJEPA ɾ span reproduced the pilot's joint curve exactly on its 10,389 sites (largest difference 0.0). On the grid's 10,334, every control-task p-value is above 0.05 (smallest 0.095); the lemma-unseen and unclipped re-scores track the full scores within about 0.02; all 5,650 fits converged.", name: "Checks passed", layer: "design"};
MERGE (n:Finding {key: "find-rc-mfcc"}) SET n += {question: "Which representation's communities follow the phonetic environment most?", status: "exploratory, not registered", statement: "MFCC's. Louvain communities over each representation's ɾ-span features (kNN graph, k = 15, cosine distance, z-scored; 10,334 sites; no probe trained) share more with the phonetic environment for MFCC than for either encoder. Adjusted mutual information (AMI) with the vowel–following pair is 0.160, against 0.089 for wav2vec2-base layer 9 and 0.043 for WavJEPA layer 3. With the preceding vowel it is 0.142 (0.080, 0.036), and with the following segment 0.104 (0.054, 0.027). Over seeds 1–20, MFCC's range for the pair (0.1355–0.1711) doesn't overlap wav2vec2-base's (0.0823–0.1068). None comes near the Site–Phone communities (built 10-28, re-run sorted 10-29), which come from the environment labels themselves (pair 0.671).", name: "MFCC's communities most phonetic", layer: "design"};
MERGE (n:Finding {key: "find-rc-speaker"}) SET n += {question: "What do WavJEPA layer 3's communities group by?", status: "exploratory, not registered", statement: "Mostly speaker. AMI with speaker is 0.234 (seeds 1–20: 0.2091–0.2724), the largest value for any representation and any grouping, against 0.126 for MFCC and 0.030 for wav2vec2-base layer 9. Its AMI with every phonetic grouping is the lowest of the three (pair 0.043). Layer 3 is WavJEPA's best on ɾ in the span grid, but that best-layer interval is wide, so a later layer could group differently; none was run.", name: "WavJEPA L3's communities follow speaker", layer: "design"};
MERGE (n:Finding {key: "find-rc-voicing"}) SET n += {question: "Do the encoders' communities line up with underlying /t/ versus /d/?", status: "exploratory, not registered", statement: "Barely, for all three. AMI with /t/–/d/ is 0.0071 for wav2vec2-base layer 9, 0.0072 for MFCC and 0.0024 for WavJEPA layer 3 (bias-corrected Cramér's V 0.147, 0.138, 0.084). wav2vec2-base is above WavJEPA on every seed (0.0067–0.0118 against 0.0014–0.0029) but tied with MFCC (0.0037–0.0085). At k = 5 the gap to MFCC widens (0.0142 against 0.0053); at k = 30 it is 0.0063 against 0.0049, so it isn't settled. For scale, the Site–Phone communities (built 10-28, re-run sorted 10-29) reach 0.0303, and the vowel–following pair itself 0.050.", name: "Communities barely track /t/–/d/", layer: "design"};
MERGE (n:Finding {key: "find-rc-stability"}) SET n += {question: "How far can the encoders' communities be read?", status: "exploratory, not registered", statement: "As a comparison, not as objects. The partitions change with the seed: their adjusted Rand index against the seeded run, median over seeds 1–20, is 0.563 for wav2vec2-base, 0.471 for WavJEPA and 0.465 for MFCC, against 0.895 for the Site–Phone communities (built 10-28, re-run sorted 10-29). What they share with each grouping is stable: the three representations' seed ranges of AMI don't overlap for any grouping except /t/–/d/. Word and environment can't be told apart in this data. For every representation, AMI with word is close to AMI with the vowel–following pair (MFCC 0.142 and 0.160, wav2vec2-base 0.096 and 0.089, WavJEPA 0.045 and 0.043). Even the Site–Phone communities, built from the environments alone, have word AMI 0.307. So \"groups by word\" and \"groups by environment\" are one observation here.", name: "Partitions unstable; comparison stable", layer: "design"};
MERGE (n:Finding {key: "find-rc-site-phone"}) SET n += {question: "Do the Site–Phone communities over the phonetic environments line up with underlying /t/ versus /d/?", status: "exploratory; corrected 2026-10-30", statement: "Weakly, and less than the environments they're built from. The 20 Site–Phone communities (built 10-28, re-run sorted 10-29; Louvain over the Site–Phone graph, modularity 0.4708) have Cramér's V 0.299 with /t/–/d/, below the vowel–following pair's own 0.536 and the preceding vowel's 0.335, so they coarsen the environments. Resampling by word, 5 of the 20 communities have a 95% interval for their /d/ share that excludes the base rate (24.3%). Wilson intervals, which treat every site as independent (as the 10-28 figure's did), put it at 16. Words recur across sites, so the word-resampled count is the one to use.", name: "Site–Phone communities: 5 of 20 by word", layer: "design"};
MERGE (n:Run {key: "run-pilot"}) SET n += {name: "pilot-20260926", run_id: "pilot-20260926", date: "2026-09-26", features_commit: "c75a23b", gate_commit: "78462eb", assemble_commit: "61ba76f", checkpoint_revision: "6be4a50", context_ms: 200.0, inventory_hash: "b378c303ca908f291da1720ec2ba11fa9a7dd1b07f8c63e6451de1d835e51162", n_sites_scored: 10389, synthetic: false, criteria_commit: "b163059", verdict: "failed, 1 of 4 criteria", seed_bootstrap: 20260928, seed_control: 20260927, seed_control_null: 20260929, seed_folds: 20260926, seed_subsample: 20260926, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:max:joint:full"}) SET n += {name: "MFCC · joint · max", representation: "mfcc", pooling: "max", condition: "joint", subsampled: false, n_layers: 1, balanced_acc: [0.527885], ci_lo: [0.477229], ci_hi: [0.579545], f1_d: [0.351975], control_balanced_acc: [0.542216], selectivity: [-0.014331], n: 10389, n_d: 2529, lookup_balanced_acc: 0.5, best_layer: 0, best_balanced_acc: 0.527885, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:max:random:full"}) SET n += {name: "MFCC · random · max", representation: "mfcc", pooling: "max", condition: "random", subsampled: false, n_layers: 1, balanced_acc: [0.581879], ci_lo: [0.532277], ci_hi: [0.630229], f1_d: [0.405289], control_balanced_acc: [0.593192], selectivity: [-0.011313], n: 10389, n_d: 2529, lookup_balanced_acc: 0.941336, best_layer: 0, best_balanced_acc: 0.581879, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:max:random:subsampled"}) SET n += {name: "MFCC · random · max · subsampled", representation: "mfcc", pooling: "max", condition: "random", subsampled: true, n_layers: 1, balanced_acc: [0.579111], ci_lo: [0.529861], ci_hi: [0.627884], f1_d: [0.402271], control_balanced_acc: [0.590332], selectivity: [-0.011221], n: 10389, n_d: 2529, lookup_balanced_acc: 0.935539, best_layer: 0, best_balanced_acc: 0.579111, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:max:speaker_disjoint:full"}) SET n += {name: "MFCC · speaker_disjoint · max", representation: "mfcc", pooling: "max", condition: "speaker_disjoint", subsampled: false, n_layers: 1, balanced_acc: [0.568693], ci_lo: [0.520637], ci_hi: [0.616799], f1_d: [0.39175], control_balanced_acc: [0.58886], selectivity: [-0.020168], n: 10389, n_d: 2529, lookup_balanced_acc: 0.930364, best_layer: 0, best_balanced_acc: 0.568693, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:max:speaker_disjoint:subsampled"}) SET n += {name: "MFCC · speaker_disjoint · max · subsampled", representation: "mfcc", pooling: "max", condition: "speaker_disjoint", subsampled: true, n_layers: 1, balanced_acc: [0.571409], ci_lo: [0.5247], ci_hi: [0.617556], f1_d: [0.395293], control_balanced_acc: [0.587619], selectivity: [-0.01621], n: 10389, n_d: 2529, lookup_balanced_acc: 0.920881, best_layer: 0, best_balanced_acc: 0.571409, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:max:word_disjoint:full"}) SET n += {name: "MFCC · word_disjoint · max", representation: "mfcc", pooling: "max", condition: "word_disjoint", subsampled: false, n_layers: 1, balanced_acc: [0.532744], ci_lo: [0.478909], ci_hi: [0.587478], f1_d: [0.357143], control_balanced_acc: [0.54367], selectivity: [-0.010926], n: 10389, n_d: 2529, lookup_balanced_acc: 0.5, best_layer: 0, best_balanced_acc: 0.532744, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:max:word_disjoint:subsampled"}) SET n += {name: "MFCC · word_disjoint · max · subsampled", representation: "mfcc", pooling: "max", condition: "word_disjoint", subsampled: true, n_layers: 1, balanced_acc: [0.54043], ci_lo: [0.488279], ci_hi: [0.594048], f1_d: [0.364096], control_balanced_acc: [0.54286], selectivity: [-0.002429], n: 10389, n_d: 2529, lookup_balanced_acc: 0.5, best_layer: 0, best_balanced_acc: 0.54043, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:mean:joint:full"}) SET n += {name: "MFCC · joint · mean", representation: "mfcc", pooling: "mean", condition: "joint", subsampled: false, n_layers: 1, balanced_acc: [0.527442], ci_lo: [0.475276], ci_hi: [0.579644], f1_d: [0.350985], control_balanced_acc: [0.531309], selectivity: [-0.003867], n: 10389, n_d: 2529, lookup_balanced_acc: 0.5, best_layer: 0, best_balanced_acc: 0.527442, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:mean:random:full"}) SET n += {name: "MFCC · random · mean", representation: "mfcc", pooling: "mean", condition: "random", subsampled: false, n_layers: 1, balanced_acc: [0.58192], ci_lo: [0.529304], ci_hi: [0.632805], f1_d: [0.405594], control_balanced_acc: [0.594683], selectivity: [-0.012763], speaker_balanced_acc: [0.692038], n: 10389, n_d: 2529, lookup_balanced_acc: 0.941336, best_layer: 0, best_balanced_acc: 0.58192, spread: 0.0, n_nonconverged: 0, layer: "design"};
MERGE (n:Curve {key: "curve:mfcc:mean:random:subsampled"}) SET n += {name: "MFCC · random · mean · subsampled", representation: "mfcc", pooling: "mean", condition: "random", subsampled: true, n_layers: 1, balanced_acc: [0.583531], ci_lo: [0.531744], ci_hi: [0.633887], f1_d: [0.407113], control_balanced_acc: [0.599557], selectivity: [-0.016026], n: 10389, n_d: 2529, lookup_balanced_acc: 0.935539, best_layer: 0, best_balanced_acc: 0.583531, spread: 0.0, n_nonconverged: 0, layer: "design"};

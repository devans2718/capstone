# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
.ipynb_checkpoints/

# Experiment scratch — anything worth keeping gets promoted into results/
outputs/
wandb/

# Secrets stay out of the repo; recovery chain is documented in the vault
.env
*.env

# Data never lives in the repo — it mounts at /data (see README).
# Audio is blanket-ignored, then stimuli/ is re-included: self-recorded
# stimuli are irreplaceable and the repo is their offsite backup.
# Anchored to the root: an unanchored data/ also swallowed the
# src/capstone/data package.
/data/
*.wav
*.mp3
*.flac
!stimuli/**/*.wav
!stimuli/*.wav

# Buckeye-derived per-site data stays local: these carry speaker codes, word
# forms and timestamps, and the corpus is distributed only through OSU's
# registration. The scripts named in README regenerate them from a registered
# copy; aggregate reports and figures are committed.
results/flapping/sites-*.parquet
results/flapping/lemma-overlap-*.tsv
results/flapping/audit-sample-*.tsv
results/corpus-verification/buckeye-*.tsv
